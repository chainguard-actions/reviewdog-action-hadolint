#!/bin/sh
# Fake wget: intercepts hadolint download URL and creates a fake hadolint binary.

out=""
prev=""
for arg in "$@"; do
  case "$prev" in
    -O) out="$arg" ;;
  esac
  prev="$arg"
done

# Check if this is the hadolint download URL
case "$*" in
  *hadolint*)
    if [ -n "$out" ]; then
      printf '#!/bin/sh\necho "[]"\nexit 0\n' > "$out"
      chmod +x "$out"
    fi
    exit 0
    ;;
esac

# Fall through to real wget for other URLs
exec /usr/bin/wget "$@"
